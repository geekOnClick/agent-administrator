{
  "name": "agent-administrator",
  "version": "1.1.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --ignore data --exec tsx src/index.ts --cli",
    "start:telegram": "nodemon --ignore data --exec tsx src/index.ts --telegram",
    "start:agent": "tsx src/index.ts --cli",
    "run-llm": "ollama run gemma4:e4b-8k",
    "model:down": "tsx src/scripts/unload-models.ts",
    "evals": "tsx src/evals/run-evals.ts --out data/evals/report.json",
    "db:up": "docker compose -p agent-administrator up -d falkordb",
    "db:down": "docker compose -p agent-administrator down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.0",
    "falkordb": "^6.7.0",
    "jszip": "^3.10.1",
    "ollama": "^0.6.3",
    "telegraf": "^4.16.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "nodemon": "^3.1.10",
    "tsx": "^4.22.3"
  }
}
